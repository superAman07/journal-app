# ==========================================
# TRADING OS — ENVIRONMENT VARIABLES SETUP
# Rename or copy this file to .env.local
# ==========================================

# 1. DATABASE (PostgreSQL - Aiven / Supabase / Neon / Local)
# Replace with your actual PostgreSQL connection URI
DATABASE_URL="postgresql://username:password@localhost:5432/trading_os?schema=public"

# 2. NEXTAUTH / AUTH.JS v5
# Generate a secret key using: npx auth secret or openssl rand -base64 32
AUTH_SECRET="your_nextauth_secret_here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. GOOGLE OAUTH CREDENTIALS (Google Cloud Console)
# Redirect URI to authorize in Google Cloud Console:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# 4. CLOUDINARY (Chart Screenshots Storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 5. AI COACH PROVIDERS (Optional / Local)
OLLAMA_BASE_URL="http://localhost:11434"
OPENAI_API_KEY="your_openai_api_key_optional"
GEMINI_API_KEY="your_gemini_api_key_optional"
